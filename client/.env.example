# Copy to `.env` and fill in values. Never commit `.env`.

# ─── API ─────────────────────────────────────────────────────────────────────
# Leave empty in dev to use the Vite proxy (/api → http://127.0.0.1:5555).
# Set it to the deployed server origin in production, e.g.
# VITE_API_URL=https://nadlan-server.up.railway.app
VITE_API_URL=

# ─── Dev ports (optional — defaults shown) ───────────────────────────────────
# Where the Vite dev server listens.
# VITE_APP_PORT=5173
# Where the NestJS server listens — must match PORT in server/.env.
# VITE_SERVER_PORT=5555
