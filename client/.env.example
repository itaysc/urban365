# Copy to `.env` and fill in values. Never commit `.env`.

# ─── API ─────────────────────────────────────────────────────────────────────
# Leave empty in dev to use the Vite proxy (/api → http://127.0.0.1:5555).
# Set it to the deployed server origin in production, e.g.
# VITE_API_URL=https://nadlan-server.up.railway.app
VITE_API_URL=

# The site's own public origin, no trailing slash. Baked into index.html at build time
# as the absolute og:image URL — the picture a shared link shows — which the browser
# cannot work out for itself. Empty in development; the share preview is the one thing
# that does not work locally anyway.
# VITE_APP_URL=https://urban365.co.il
VITE_APP_URL=

# ─── Dev ports (optional — defaults shown) ───────────────────────────────────
# Where the Vite dev server listens.
# VITE_APP_PORT=5173
# Where the NestJS server listens — must match PORT in server/.env.
# VITE_SERVER_PORT=5555

# ─── Map ─────────────────────────────────────────────────────────────────────
# MapLibre style URL. Defaults to OpenFreeMap's "bright" style when unset.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
