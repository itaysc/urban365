{
  "name": "nadlan-server",
  "version": "1.0.0",
  "description": "Nadlan API (NestJS)",
  "author": "Itay Schmidt",
  "private": true,
  "license": "ISC",
  "type": "module",
  "scripts": {
    "db": "bash ../scripts/start-db.sh",
    "dev": "npm run db && nest start --watch",
    "dev:prod": "node scripts/dev-prod.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:generate": "prisma generate",
    "import:cache": "node dist/scripts/import-cache.js",
    "grant:admin": "node dist/scripts/grant-admin.js",
    "seed:dev-agency": "node dist/scripts/seed-dev-agency.js",
    "seed:demo": "npm run build && node dist/scripts/seed-demo-data.js",
    "sync:deals": "npm run build && node dist/scripts/sync-deals.js",
    "import:parcels": "npm run build && node dist/scripts/import-parcels.js",
    "backfill:cadastre": "npm run build && node dist/scripts/backfill-cadastre.js",
    "backfill:deal-cells": "npm run build && node dist/scripts/backfill-deal-cells.js",
    "fit:valuation": "npm run build && node dist/scripts/fit-valuation-params.js",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "oxlint --type-aware src/ test/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:debug": "vitest --inspect-brk --no-file-parallelism",
    "test:e2e": "vitest run --config ./vitest.config.e2e.ts",
    "storage:init": "node scripts/init-storage.mjs",
    "boundaries:sync": "node scripts/sync-boundaries.mjs",
    "cities:generate": "node scripts/generate-cities.mjs",
    "neighborhoods:build": "node scripts/merge-neighborhoods.mjs",
    "streets:sync": "node scripts/sync-streets.mjs",
    "try:valuation": "npm run build && node dist/scripts/try-valuation.js",
    "backtest:valuation": "npm run build && node dist/scripts/backtest-valuation.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.726.1",
    "@aws-sdk/s3-request-presigner": "3.726.1",
    "@nestjs-cls/transactional": "4.0.2",
    "@nestjs-cls/transactional-adapter-prisma": "2.0.2",
    "@nestjs/common": "^12.0.1",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "^12.0.1",
    "@nestjs/throttler": "6.7.1",
    "@node-rs/argon2": "2.2.2",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "1.4.7",
    "dotenv": "18.0.9",
    "helmet": "^8.1.0",
    "multer": "2.0.2",
    "nestjs-cls": "7.0.2",
    "openai": "6.49.0",
    "pg": "8.23.1",
    "playwright": "^1.49.1",
    "prisma": "7.10.1",
    "reflect-metadata": "^0.2.2",
    "resend": "6.35.0",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.0",
    "@nestjs/schematics": "^12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "^5.0.0",
    "@types/multer": "2.0.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "@types/supertest": "^7.0.0",
    "@vitest/coverage-v8": "^4.1.2",
    "oxlint": "^1.58.0",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  }
}
