// Postgres with a typed core plus a raw JSON column per record.
//
// The typed columns are the ones we filter, sort and join on. `raw` keeps the exact
// yad2 payload the record came from, so nothing is lost to the mapping and a new yad2
// field needs no migration to be captured — only one to start querying it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Section {
  forsale
  rent
  commercial
}

enum ListingSource {
  yad2
  import
  manual
}

/// Where an agency row stands. Scraped rows start `unclaimed` and nobody owns them.
enum AgencyStatus {
  unclaimed
  pending
  active
  rejected
  suspended
}

enum AgencyRole {
  owner
  agent
}

/// Platform staff, entirely separate from an agency role. Never writable over the API.
enum PlatformRole {
  admin
  support
}

enum MembershipStatus {
  pending
  active
  suspended
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum AuthTokenPurpose {
  email_verify
  password_reset
  agency_invite
  email_change
}

/// A listing is only public while `published`.
enum ListingStatus {
  draft
  published
  archived
}

/// What an automated read of a listing concluded about it.
enum ListingReviewStatus {
  /// Never looked at. Everything scraped from yad2, and everything an agency writes.
  unchecked
  /// Looks like a real property.
  clean
  /// Does not. Kept, never shown, and waiting for a person to agree or disagree.
  flagged
}

enum LeadSource {
  web
  manual
  import
}

enum LeadStatus {
  new
  contacted
  viewing
  offer
  won
  lost
}

enum DealStage {
  qualified
  negotiation
  under_contract
  closed_won
  closed_lost
}

model Agency {
  id     String  @id @default(cuid())
  /// yad2's customerId. Null for agencies created here rather than scraped — Postgres
  /// allows many NULLs under a unique index, so both kinds share the constraint.
  yad2Id String? @unique
  /// Public URL segment, assigned when the agency is activated.
  slug   String? @unique

  status          AgencyStatus @default(unclaimed)
  contactEmail    String?
  reviewedAt      DateTime?
  reviewedBy      User?        @relation("AgencyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  rejectionReason String?

  name          String
  licenseNumber String?
  phone         String?
  logoUrl       String?
  /// Banner on the agency's public page. Uploaded here, unlike logoUrl which may still
  /// point at yad2's CDN for scraped agencies. The URL is a path this API serves; the
  /// object itself lives in a private bucket under `coverStorageKey`.
  coverImageUrl   String?
  coverStorageKey String?
  description   String?

  /// [{ day, open, close }]
  openingHours Json?

  assetsForSaleCount    Int?
  assetsForRentCount    Int?
  commercialAssetsCount Int?

  brokers     Broker[]
  offices     AgencyOffice[]
  listings    Listing[]
  runs        ScrapeRun[]
  memberships AgencyMembership[]
  claims      AgencyClaim[]
  invites     AgencyInvite[]
  leads       Lead[]
  deals       Deal[]
  customers   Customer[]
  meetings    Meeting[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
}

model Broker {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  /// yad2's broker id; unique per agency, not globally.
  yad2Id            String?
  name              String
  licenseNumber     String?
  activeAssetsCount Int?
  specialization    String?
  avatarUrl         String?

  membership AgencyMembership?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, yad2Id])
  @@index([agencyId])
}

model Listing {
  id      String        @id @default(cuid())
  /// yad2's ad token, and the key every scrape upserts on. **Null for listings created
  /// here** — so `token IS NOT NULL` is exactly "came from yad2". That is why this is
  /// nullable rather than carrying a synthetic value.
  token   String?       @unique
  source  ListingSource @default(yad2)
  /// Only `published` rows are public. Defaulted so the existing scraped rows stay visible.
  status  ListingStatus @default(published)
  section Section

  createdBy       User?     @relation("ListingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  publishedAt     DateTime?

  /// Null for a listing published by a private seller, who has no agency at all.
  /// Exactly one of `agencyId` and `ownerUserId` is set, enforced by a check constraint.
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String?

  /// A person selling their own property, rather than an agency selling it for them.
  ///
  /// Deliberately not a one-person agency: a private seller has no team, no licence and
  /// no leads pipeline — and every tenant policy compares `agencyId`, which NULL fails,
  /// so a private listing is invisible to every agency by construction rather than by a
  /// filter somebody has to remember to write.
  owner       User?   @relation("ListingOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId String?

  /// How many different people opened it, and how many asked for the number.
  ///
  /// Counts of people rather than of page loads — a reload is not interest. Maintained
  /// from `ListingEngagement`, which is what makes "different people" true.
  viewCount        Int @default(0)
  phoneRevealCount Int @default(0)

  /// What the spam check made of this listing, for the ones that get checked — which is
  /// private sellers. An agency has a licence and a claim on the line; a stranger with
  /// an email address does not, and that is the whole difference.
  reviewStatus ListingReviewStatus @default(unchecked)
  /// Why, in the model's own words. Kept so a person reviewing the queue can see what
  /// it objected to rather than re-reading the listing cold.
  reviewReason String?
  /// 0–100. How sure it was, not how bad the listing is.
  reviewConfidence Int?
  reviewedAt       DateTime?

  adNumber   BigInt?
  listingUrl String?

  // --- the fields search actually filters and sorts on
  price               Int?
  priceBeforeDrop     Int?
  pricePerSquareMeter Int?

  propertyType       String?
  propertyGroup      String?
  propertyCondition  String?
  rooms              Float?
  floor              Int?
  buildingTopFloor   Int?
  squareMeter        Int?
  squareMeterBuilt   Int?
  squareMeterGarden  Int?
  balconiesCount     Int?
  parkingSpacesCount Int?

  city         String?
  neighborhood String?
  street       String?
  houseNumber  Int?
  region       String?
  area         String?
  latitude     Float?
  longitude    Float?

  /// Labels of what the property has. A GIN index makes "has מעלית and ממ\"ד" fast.
  amenities String[]
  tags      String[]

  description   String?
  coverImageUrl String?
  /// yad2 CDN urls, kept only until listings carry our own images.
  imageUrls     String[]
  imagesCount   Int      @default(0)

  contactName         String?
  brokerName          String?
  brokerLicenseNumber String?

  /// Whether the detail page was read, or only the agency-feed card.
  hasFullDetails Boolean @default(false)

  /// How many people have saved this listing — accounts and signed-out browsers alike.
  ///
  /// Denormalised because it is read for every card in every result page and written
  /// only when somebody clicks a heart.
  savedCount Int @default(0)

  /// The agency holds this property exclusively. yad2 ships the same fact as a flag on
  /// the raw payload, so this column is kept in step with the בלעדיות label in
  /// `amenities` — one column to query, one label the search and the cards already read.
  isExclusive Boolean @default(false)

  /// Sold by the developer rather than by a previous owner — דירה מקבלן.
  ///
  /// Set by the agency, not derived: yad2's feed has no equivalent flag, so a scraped
  /// listing arrives false and stays false until someone who knows says otherwise.
  isNewFromDeveloper Boolean @default(false)

  /// The yad2 payload exactly as collected.
  raw Json?

  listedAt        DateTime?
  updatedAtSource DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  /// Set when a listing stops appearing in the feed, instead of deleting history.
  delistedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images      ListingImage[]
  engagements ListingEngagement[]
  leads  Lead[]
  deals  Deal[]
  saves  SavedListing[]
  meetings Meeting[]

  @@index([ownerUserId])
  @@index([agencyId, section])
  @@index([agencyId, status])
  @@index([city, price])
  @@index([section, price])
  @@index([rooms])
  @@index([delistedAt])
  @@index([amenities], type: Gin)
}

/// One row per scrape, so a bad run can be told apart from a shrinking inventory.
model ScrapeRun {
  id       String  @id @default(cuid())
  agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String
  section  Section

  cardsFound       Int
  listingsUpserted Int
  detailsMissing   Int
  failedTokens     String[]

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([agencyId, section, startedAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Identity and access
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(cuid())
  /// Always stored lowercased. Postgres unique indexes are case-sensitive, so without
  /// normalising, Itay@x.com and itay@x.com are two accounts and the anti-enumeration
  /// responses quietly stop working. Normalise in auth/normalize-email.ts.
  email        String @unique
  passwordHash String

  firstName String
  lastName  String
  phone     String?
  /// Profile picture. `avatarUrl` is a path this API serves; the object lives in the
  /// private bucket under `avatarStorageKey`. Null means fall back to initials.
  avatarUrl        String?
  avatarStorageKey String?
  /// A short self-description shown beside this agent's listings. Capped in the DTO at
  /// BIO_MAX_LENGTH; the column is unbounded so raising the cap needs no migration.
  bio              String?

  emailVerifiedAt DateTime?
  /// null = ordinary user. Set by seed or SQL only, never through an API.
  /// When this person agreed to the terms and the privacy policy.
  ///
  /// A timestamp rather than a boolean: what matters later is *when* they agreed, so a
  /// change to either document can be told apart from an account that predates it.
  termsAcceptedAt DateTime?

  platformRole    PlatformRole?

  /// Bumping this invalidates every outstanding token: a cheap "log out everywhere".
  sessionEpoch     Int       @default(0)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  disabledAt       DateTime?

  /// What this account is for. Explicit rather than inferred from "has a membership":
  /// the inference is true today but silently wrong the moment a buyer is invited to an
  /// agency, and it cannot be queried or indexed.
  accountType AccountType @default(buyer)

  /// Set when the account signed in through an identity provider. A row with a
  /// provider and no usable password came in through Google and must not be offered a
  /// password reset as though it had one.
  authProvider   AuthProvider?
  /// The provider's stable subject id. Never the email — Google addresses can change.
  authProviderId String?

  /// Present for a consumer: someone searching for a home rather than selling one.
  /// Identity stays in this table so there is one login, one session and one reset
  /// flow; only the consumer-specific data lives separately.
  buyerProfile BuyerProfile?

  memberships      AgencyMembership[]
  sessions         Session[]
  authTokens       AuthToken[]
  claims           AgencyClaim[]
  createdListings  Listing[]          @relation("ListingCreator")
  ownedListings    Listing[]          @relation("ListingOwner")
  ownedLeads       Lead[]             @relation("LeadOwner")
  assignedLeads    Lead[]             @relation("LeadAssignee")
  assignedCustomers Customer[]        @relation("CustomerAssignee")
  meetings          Meeting[]          @relation("MeetingOwner")
  googleCalendar    GoogleCalendarAccount?
  ownedDeals       Deal[]             @relation("DealOwner")
  reviewedAgencies Agency[]           @relation("AgencyReviewer")
  reviewedClaims   AgencyClaim[]      @relation("ClaimReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platformRole])
  @@index([accountType])
  @@unique([authProvider, authProviderId])
}

enum AuthProvider {
  google
}

enum AccountType {
  /// A consumer searching for a home. Has a BuyerProfile, no AgencyMembership.
  buyer
  /// Staff of an estate agency. Has a membership; may also have a BuyerProfile.
  agency
}

/// Everything a buyer has that an agency member does not. Keeping it out of `User`
/// means the consumer side can grow — alerts, search history, comparisons — without
/// widening the table every authentication path reads on each request.
model BuyerProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  /// Free-text notes on what they are looking for; shown back to them, never public.
  searchNotes String?

  /// Notification preferences. Separate booleans rather than a JSON blob so they can
  /// be queried — "who wants a weekly digest" is a real question.
  notifyOnPriceDrop  Boolean @default(true)
  notifyOnNewMatches Boolean @default(true)
  weeklyDigest       Boolean @default(false)

  savedListings SavedListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A listing a buyer kept. The join carries its own note, which is the point — "nice
/// kitchen, bad street" is what makes a shortlist useful.
model SavedListing {
  id String @id @default(cuid())

  /// Exactly one of these is set, enforced by a check constraint rather than by hope:
  /// a save belongs to an account, or to a browser that has not made one yet.
  profile   BuyerProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String?
  visitor   Visitor?      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitorId String?

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  note      String?
  createdAt DateTime @default(now())

  // Uniqueness is two partial indexes in the migration, not `@@unique` here: with a
  // nullable column Postgres counts NULLs as distinct, so a single compound unique
  // would let one visitor save the same listing any number of times.
  @@index([profileId, createdAt])
  @@index([visitorId, createdAt])
  @@index([listingId])
}

/// One person's interaction with one listing, so that a count can mean people.
///
/// A row per person per listing per kind, not per click: the seller's question is how
/// many people looked, and a page refreshed four times is one person.
model ListingEngagement {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  kind EngagementKind

  /// Whoever we can name: the account when there is one, otherwise the browser.
  userId    String?
  visitorId String?

  createdAt DateTime @default(now())

  @@index([listingId, kind])
}

enum EngagementKind {
  /// The listing was opened.
  view
  /// The contact number was asked for.
  phone
}

/// A browser that has saved something without signing up.
///
/// The id is random and opaque and means nothing on its own — it identifies a browser,
/// not a person, and carries no name, address or device characteristics. It exists so
/// that saving a listing works before anyone has decided to make an account, and it is
/// folded into that account the moment they do.
model Visitor {
  id String @id @default(cuid())

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  /// Set when the browser's saves were merged into an account. The row is kept rather
  /// than deleted so the same cookie does not quietly start a second collection.
  mergedIntoProfileId String?

  savedListings SavedListing[]

  @@index([lastSeenAt])
}

/// A user's place in an agency. A join model rather than fields on User, because a
/// `pending` membership has nowhere to live on the user row, the claim needs an audit
/// trail, and agents move between agencies.
model AgencyMembership {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  role   AgencyRole       @default(agent)
  status MembershipStatus @default(pending)

  /// Display link to the yad2-imported team row — avatar, licence number, counts.
  /// NEVER an authorization input: the scraper rewrites Broker rows on every run and
  /// matches some of them on name alone.
  broker   Broker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  brokerId String? @unique

  invitedById String?
  joinedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, agencyId])
  @@index([agencyId, status])
}

/// A request to take over an agency that already exists from a scrape. Approving one
/// attaches the existing row to the claimant — nothing is ever merged or re-parented.
model AgencyClaim {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  status   ClaimStatus @default(pending)
  /// Whatever the signup form collected: licence number, office phone, a note.
  evidence Json?

  reviewedAt      DateTime?
  reviewedBy      User?     @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  rejectionReason String?

  createdAt DateTime @default(now())

  @@unique([agencyId, userId])
  @@index([status, createdAt])
}

model AgencyInvite {
  id          String     @id @default(cuid())
  agency      Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId    String
  email       String
  role        AgencyRole @default(agent)
  invitedById String
  /// sha256 of the token; the plaintext only ever exists in the email.
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([agencyId, acceptedAt])
}

/// One row per refresh token. A login starts a family; each rotation adds a row and
/// tombstones its predecessor, so presenting a revoked token is provable reuse.
model Session {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Constant across every rotation of one login. Reuse kills the whole family.
  familyId  String
  /// sha256 of the token's secret half; the plaintext lives only in the cookie.
  tokenHash String

  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  replacedBy   Session?  @relation("SessionChain", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     Session?  @relation("SessionChain")

  ip         String?
  userAgent  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

/// Email verification, password reset and invite acceptance in one table — one lookup
/// path and one expiry sweep. Hashes only, compared with timingSafeEqual.
model AuthToken {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int              @default(0)
  /// e.g. the proposed address for an email_change.
  meta       Json?
  createdAt  DateTime         @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// CRM
// ──────────────────────────────────────────────────────────────────────────────

/// Photos an agency uploaded here. Scraped listings keep using Listing.imageUrls,
/// which are yad2 CDN links and will be retired once agencies upload their own.
model ListingImage {
  id         String   @id @default(cuid())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  /// Object key in the bucket; the public URL is derived from it.
  storageKey String   @unique
  url        String
  width      Int?
  height     Int?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([listingId, position])
}

/// Why an agency is talking to somebody. Not a status — a person can be looking to buy
/// one flat and to sell another at the same time, which is the `both` case.
enum CustomerKind {
  buyer
  seller
  both
}

/// A person the agency keeps, as opposed to an enquiry it received.
///
/// Distinct from `Lead` on purpose. A lead is an event — somebody asked about one
/// listing on one day, and it is answered or it goes cold. A customer is a relationship:
/// the same person over years, several properties, whatever the agent knows about them.
/// Collapsing the two would mean either losing which listing an enquiry was about, or
/// carrying a dead listing reference around a person who no longer cares about it.
model Customer {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  name  String
  phone String?
  email String?

  kind  CustomerKind @default(buyer)
  notes String?

  // ── what they are looking for ───────────────────────────────────────────────
  // The brief, in the same shape the public search takes it, so "show me what has
  // come in for this customer" is the ordinary search with these as its filters
  // rather than a second thing to keep in step.

  /// Buying, renting or commercial. Null while nobody has asked.
  lookingSection Section?
  /// Where. Several, because a brief is usually "Holon or Bat Yam".
  lookingCities  String[]
  /// Flat, penthouse, and so on. Empty means no preference stated.
  lookingTypes   String[]

  minRooms Float?
  maxRooms Float?
  minPrice Int?
  maxPrice Int?
  minSquareMeter Int?

  /// The agent who looks after them. Optional: a walk-in belongs to the agency before
  /// anybody has picked them up.
  assignedTo   User?   @relation("CustomerAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings Meeting[]

  /// The list is "this agency's, newest first", which is the only query there is.
  @@index([agencyId, createdAt])
  @@index([assignedToId])
}

model Lead {
  id        String   @id @default(cuid())
  /// Null when the enquiry is about a private seller's listing, which has no agency.
  /// Exactly one of `agencyId` and `ownerUserId` is set.
  agency    Agency?  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId  String?

  /// The private seller the enquiry is for. An enquiry nobody receives is worse than
  /// no enquiry form, so this exists for the same reason `Listing.ownerUserId` does.
  owner       User?   @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId String?

  /// The listing the enquiry came in on, when there was one.
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId String?

  source LeadSource @default(web)
  status LeadStatus @default(new)

  name    String
  phone   String?
  email   String?
  message String?
  notes   String?

  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  deals Deal[]

  contactedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agencyId, status, createdAt])
  @@index([listingId])
  @@index([assignedToId])
}

/// A user's connected Google Calendar.
///
/// Its own row rather than columns on `User`, so disconnecting is a delete — there is
/// no half-connected state where a stale refresh token sits beside a null calendar id.
///
/// The refresh token is stored as given, because unlike every other token in this
/// schema it has to be *used* rather than compared: hashing it would make it useless.
/// It is a credential for somebody's calendar and should be treated as one.
model GoogleCalendarAccount {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  /// The Google account that was connected, for showing which one it is.
  googleEmail String

  refreshToken String
  /// Which calendar to write to. `primary` unless somebody picks another.
  calendarId   String @default("primary")

  /// When the last push or pull failed, and why — so a connection that has quietly
  /// stopped working can say so instead of looking fine.
  lastError   String?
  lastSyncAt  DateTime?
  connectedAt DateTime  @default(now())
}

/// A meeting is either still coming, or it happened, or it did not.
enum MeetingStatus {
  scheduled
  done
  cancelled
}

/// Something in an agent's diary: a viewing, a valuation, a signing.
///
/// Ours, not Google's. An agency that never connects a Google account still has a
/// working calendar, and one that connects it gets its meetings pushed there — the
/// relationship is "we own the record, Google is a copy", because the other way round
/// means losing the diary when somebody revokes an OAuth grant.
model Meeting {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  /// Who it is with. Optional: a team meeting is still a meeting.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  /// The property it is about, for a viewing.
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId String?

  title    String
  startsAt DateTime
  endsAt   DateTime
  location String?
  notes    String?

  status MeetingStatus @default(scheduled)

  /// Whose diary it is. Null means the agency's rather than one agent's.
  owner   User?   @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  /// The copy in Google, when the owner has connected an account. Null means it was
  /// never pushed — because nobody is connected, or because the push failed, which is
  /// not a reason to refuse the meeting.
  googleEventId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The calendar asks for one range at a time, which is the only query there is.
  @@index([agencyId, startsAt])
  @@index([customerId])
  @@index([ownerId])
}

model Deal {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId    String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId String?

  stage DealStage @default(qualified)
  title String

  /// Agreed price, and the agency's commission, both in whole shekels.
  price      Int?
  commission Int?

  expectedCloseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  notes           String?

  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, stage, createdAt])
  @@index([leadId])
}

/// A place an agency works out of, drawn on the public map under the agency's name.
///
/// Separate from `Agency.phone` and the rest of the profile because an agency has more
/// than one: a head office and branches, each in a different town, each worth finding.
model AgencyOffice {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  /// "סניף רמת גן". Optional — one office needs no name beyond the agency's own.
  label String?

  city        String
  street      String?
  houseNumber Int?

  /// Worked out from the address when it was saved, not at render time: a map showing
  /// twenty offices would otherwise be twenty geocoding requests per view.
  ///
  /// Null when the address could not be placed. Such an office still exists and still
  /// shows in the agency's own list — it is simply not drawn.
  latitude  Float?
  longitude Float?

  /// A branch number, where it differs from the agency's main line.
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

/// Outlines the map draws: municipalities, and the regions people actually search by.
///
/// Pulled from OpenStreetMap once by `npm run boundaries:sync` rather than fetched per
/// request: Nominatim's policy forbids systematic use, Overpass rate-limits anonymous
/// callers, and a municipal boundary changes about never. Storing them makes the map
/// independent of either service being up.
/// Every street in Israel, from the Interior Ministry's list via data.gov.il.
///
/// A table rather than a file shipped to the browser: 63,000 streets is a megabyte
/// nobody should download to fill in one address field. The city list is 1,300 names
/// and goes in the bundle; this one is answered per city, as it is typed.
model Street {
  id String @id @default(cuid())

  /// The locality as the source spells it, kept for display and for tracing a row back.
  city String
  /// What the lookup matches on — `cityKey(city)`, because the city on a form comes
  /// from the locality file and the two spellings of a hyphenated name must meet.
  cityKey String
  name    String

  /// The Interior Ministry's own code for the street within its locality. Not used for
  /// anything yet; kept because re-deriving it later would mean another import.
  code Int?

  syncedAt DateTime @default(now())

  /// One row per street per city. The sync upserts on it, so a re-run updates rather
  /// than duplicates.
  @@unique([cityKey, name])
  /// What the suggestions query filters and orders by.
  @@index([cityKey, name])
}

model CityBoundary {
  id String @id @default(cuid())

  /// The name exactly as OpenStreetMap has it, for display and for tracing a row back.
  name   String
  nameEn String?

  /// What the lookup actually matches on: `name` with separators and Hebrew
  /// punctuation flattened, because OSM writes `תל־אביב–יפו` and a listing says
  /// `תל אביב יפו`. See `cityKey` in src/listings/city-name.ts — both sides use it.
  ///
  /// Unique within a kind rather than overall: a region and a city can legitimately
  /// share a name, and `חיפה` is both a city and part of a region's name.
  matchKey String

  /// A single municipality, or a region made of several.
  kind BoundaryKind @default(city)

  /// For a region: every city it covers, so a search for it is an ordinary `city IN`
  /// and needs no geometry at query time. Worked out during the sync by testing each
  /// city's centre against the region's outline. Empty for a city, which is itself.
  memberCities String[]

  /// The OSM relation this came from, so a re-sync can tell an update from a new row
  /// and a human can go and look at the source. Null for a region, which is assembled
  /// from several relations rather than being one.
  osmRelationId BigInt? @unique
  /// 8 is a municipality. 10 would be a neighbourhood, where Israeli coverage is thin.
  /// A region carries the level of the units it was built from.
  adminLevel    Int    @default(8)

  /// A GeoJSON Polygon or MultiPolygon. Kept whole rather than normalised into points:
  /// nothing queries inside it, the map just draws it.
  geometry Json

  /// The bounding box, extracted on write so the map can frame the area without
  /// parsing the geometry first.
  minLat Float
  maxLat Float
  minLng Float
  maxLng Float

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, matchKey])
  @@index([adminLevel])
  @@index([kind])
}

/// A municipality, or a marketing region assembled from several sub-districts.
enum BoundaryKind {
  city
  district
}
