// Postgres with a typed core plus a raw JSON column per record.
//
// The typed columns are the ones we filter, sort and join on. `raw` keeps the exact
// yad2 payload the record came from, so nothing is lost to the mapping and a new yad2
// field needs no migration to be captured — only one to start querying it.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Section {
  forsale
  rent
  commercial
}

enum ListingSource {
  yad2
  import
  manual
}

/// Where an agency row stands. Scraped rows start `unclaimed` and nobody owns them.
enum AgencyStatus {
  unclaimed
  pending
  active
  rejected
  suspended
}

enum AgencyRole {
  owner
  agent
}

/// Platform staff, entirely separate from an agency role. Never writable over the API.
enum PlatformRole {
  admin
  support
}

enum MembershipStatus {
  pending
  active
  suspended
}

enum ClaimStatus {
  pending
  approved
  rejected
}

enum AuthTokenPurpose {
  email_verify
  password_reset
  agency_invite
  email_change
}

/// A listing is only public while `published`.
enum ListingStatus {
  draft
  published
  archived
  /// Hidden at the owner's request. The row stays; nothing public lists it.
  removed
}

/// Why a listing was taken down for good. Kept so we know whether it sold.
enum ListingRemovalReason {
  sold
  rented
  regret
  other
}

/// What an automated read of a listing concluded about it.
enum ListingReviewStatus {
  /// Never looked at. Everything scraped from yad2, and everything an agency writes.
  unchecked
  /// Looks like a real property.
  clean
  /// Does not. Kept, never shown, and waiting for a person to agree or disagree.
  flagged
}

/// A person's decision about a private listing, used only while review mode is on.
/// Agencies never enter this queue.
enum ListingApproval {
  /// Review mode was off when it was published, or nobody has asked yet.
  none
  pending
  approved
  rejected
}

enum LeadSource {
  web
  manual
  import
}

enum LeadStatus {
  new
  contacted
  viewing
  offer
  won
  lost
}

enum DealStage {
  qualified
  negotiation
  under_contract
  closed_won
  closed_lost
}

model Agency {
  id     String  @id @default(cuid())
  /// yad2's customerId. Null for agencies created here rather than scraped — Postgres
  /// allows many NULLs under a unique index, so both kinds share the constraint.
  yad2Id String? @unique
  /// Public URL segment, assigned when the agency is activated.
  slug   String? @unique

  status          AgencyStatus @default(unclaimed)
  contactEmail    String?
  reviewedAt      DateTime?
  reviewedBy      User?        @relation("AgencyReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  rejectionReason String?

  name            String
  licenseNumber   String?
  phone           String?
  logoUrl         String?
  /// Banner on the agency's public page. Uploaded here, unlike logoUrl which may still
  /// point at yad2's CDN for scraped agencies. The URL is a path this API serves; the
  /// object itself lives in a private bucket under `coverStorageKey`.
  coverImageUrl   String?
  coverStorageKey String?
  description     String?

  /// [{ day, open, close }]
  openingHours Json?

  assetsForSaleCount    Int?
  assetsForRentCount    Int?
  commercialAssetsCount Int?

  brokers     Broker[]
  offices     AgencyOffice[]
  listings    Listing[]
  runs        ScrapeRun[]
  memberships AgencyMembership[]
  claims      AgencyClaim[]
  invites     AgencyInvite[]
  leads       Lead[]
  deals       Deal[]
  customers   Customer[]
  meetings    Meeting[]
  suggestions Suggestion[]
  demoRecords DemoRecord[]

  /// Whether this agency takes part in co-brokerage at all.
  ///
  /// On by default: the inventory it exposes is already public on the marketplace, and
  /// a network nobody has joined is worth nothing to the first agency that does. One
  /// toggle on the agency page turns it off.
  coBrokerage Boolean @default(true)

  coBrokeHolding  CoBrokerageRequest[] @relation("CoBrokeHolding")
  coBrokeSeeking  CoBrokerageRequest[] @relation("CoBrokeSeeking")
  coBrokeMessages CoBrokerageMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([status])
}

model Broker {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  /// yad2's broker id; unique per agency, not globally.
  yad2Id            String?
  name              String
  licenseNumber     String?
  activeAssetsCount Int?
  specialization    String?
  avatarUrl         String?

  membership AgencyMembership?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agencyId, yad2Id])
  @@index([agencyId])
}

model Listing {
  id      String        @id @default(cuid())
  /// yad2's ad token, and the key every scrape upserts on. **Null for listings created
  /// here** — so `token IS NOT NULL` is exactly "came from yad2". That is why this is
  /// nullable rather than carrying a synthetic value.
  token   String?       @unique
  source  ListingSource @default(yad2)
  /// Only `published` rows are public. Defaulted so the existing scraped rows stay visible.
  status  ListingStatus @default(published)
  section Section

  createdBy       User?     @relation("ListingCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdByUserId String?
  publishedAt     DateTime?

  /// Null for a listing published by a private seller, who has no agency at all.
  /// Exactly one of `agencyId` and `ownerUserId` is set, enforced by a check constraint.
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String?

  /// A person selling their own property, rather than an agency selling it for them.
  ///
  /// Deliberately not a one-person agency: a private seller has no team, no licence and
  /// no leads pipeline — and every tenant policy compares `agencyId`, which NULL fails,
  /// so a private listing is invisible to every agency by construction rather than by a
  /// filter somebody has to remember to write.
  owner       User?   @relation("ListingOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId String?

  /// How many different people opened it, and how many asked for the number.
  ///
  /// Counts of people rather than of page loads — a reload is not interest. Maintained
  /// from `ListingEngagement`, which is what makes "different people" true.
  viewCount        Int @default(0)
  phoneRevealCount Int @default(0)

  /// What the spam check made of this listing, for the ones that get checked — which is
  /// private sellers. An agency has a licence and a claim on the line; a stranger with
  /// an email address does not, and that is the whole difference.
  reviewStatus     ListingReviewStatus @default(unchecked)
  /// Why, in the model's own words. Kept so a person reviewing the queue can see what
  /// it objected to rather than re-reading the listing cold.
  reviewReason     String?
  /// 0–100. How sure it was, not how bad the listing is.
  reviewConfidence Int?
  reviewedAt       DateTime?

  /// Set when review mode holds a private listing for a person. `none` means the
  /// listing was not waiting: review mode was off, or it belongs to an agency.
  approval      ListingApproval @default(none)
  /// What the admin wrote when they declined it. This is the text of the email.
  rejectionNote String?
  decidedAt     DateTime?

  adNumber   BigInt?
  listingUrl String?

  // --- the fields search actually filters and sorts on
  price               Int?
  /// yad2's own "was" figure, straight from their feed. Only a scraped listing has one,
  /// and only while yad2 chooses to show it — `ListingPriceChange` is ours and is the
  /// one that covers every listing and keeps every change.
  priceBeforeDrop     Int?
  pricePerSquareMeter Int?

  // ── the most recent drop, kept here as well as in the history ────────────────
  // A results page badges thirty cards at once and must not ask the history thirty
  // questions to do it. Written whenever a drop is recorded and cleared when the price
  // goes back up, because a listing that rose is not a listing on sale.

  /// How much the price came down by, in shekels. Always positive.
  lastPriceDropAmount Int?
  lastPriceDropAt     DateTime?

  propertyType       String?
  propertyGroup      String?
  propertyCondition  String?
  rooms              Float?
  floor              Int?
  buildingTopFloor   Int?
  squareMeter        Int?
  squareMeterBuilt   Int?
  squareMeterGarden  Int?
  balconiesCount     Int?
  parkingSpacesCount Int?

  city         String?
  neighborhood String?
  street       String?
  houseNumber  Int?
  region       String?
  area         String?
  latitude     Float?
  longitude    Float?

  /// The cadastral block and parcel this listing sits on, from GovMap.
  ///
  /// Resolved once on write and stored, never looked up while a page renders. It is
  /// the only key that joins a listing to `Deal`: the transaction registry records a
  /// location as settlement plus gush/chelka and has no street addresses at all, so
  /// without these two numbers our listings and the country's sale prices cannot be
  /// put in the same sentence.
  gush       Int?
  chelka     Int?
  /// When the lookup last ran — including when it ran and found nothing, so a listing
  /// GovMap cannot place is not retried on every pass.
  cadastreAt DateTime?

  /// Labels of what the property has. A GIN index makes "has מעלית and ממ\"ד" fast.
  amenities String[]
  tags      String[]

  description   String?
  coverImageUrl String?
  /// yad2 CDN urls, kept only until listings carry our own images.
  imageUrls     String[]
  imagesCount   Int      @default(0)

  contactName String?
  brokerName  String?

  /// Whose property it is, as a record in the agency's own CRM.
  ///
  /// `contactName` above is a name on a yad2 ad and nothing more — you cannot ring it,
  /// and you certainly cannot ask it whether Tuesday at four suits. This is the person,
  /// with a phone and an address, so a viewing can be put to them before it is promised
  /// to a buyer. Null on a scraped listing and on one nobody has got round to filling
  /// in, which is why every path that needs it says so rather than assuming.
  sellerCustomer      Customer? @relation("ListingSeller", fields: [sellerCustomerId], references: [id], onDelete: SetNull)
  sellerCustomerId    String?
  brokerLicenseNumber String?

  /// Whether the detail page was read, or only the agency-feed card.
  hasFullDetails Boolean @default(false)

  /// How many people have saved this listing — accounts and signed-out browsers alike.
  ///
  /// Denormalised because it is read for every card in every result page and written
  /// only when somebody clicks a heart.
  savedCount Int @default(0)

  /// The agency holds this property exclusively. yad2 ships the same fact as a flag on
  /// the raw payload, so this column is kept in step with the בלעדיות label in
  /// `amenities` — one column to query, one label the search and the cards already read.
  isExclusive Boolean @default(false)

  /// Sold by the developer rather than by a previous owner — דירה מקבלן.
  ///
  /// Set by the agency, not derived: yad2's feed has no equivalent flag, so a scraped
  /// listing arrives false and stays false until someone who knows says otherwise.
  isNewFromDeveloper Boolean @default(false)

  /// The yad2 payload exactly as collected.
  raw Json?

  listedAt        DateTime?
  updatedAtSource DateTime?
  firstSeenAt     DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  /// Set when a listing stops appearing in the feed, instead of deleting history.
  delistedAt      DateTime?

  /// Set when the owner removes the listing. The row is kept; it is left out of
  /// every listing they and the public see.
  removedAt      DateTime?
  removalReason  ListingRemovalReason?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  images       ListingImage[]
  priceChanges ListingPriceChange[]
  engagements  ListingEngagement[]
  leads        Lead[]
  deals        Deal[]
  saves        SavedListing[]
  meetings     Meeting[]
  suggestions  Suggestion[]
  coBrokerage  CoBrokerageRequest[]

  @@index([ownerUserId])
  @@index([approval])
  @@index([sellerCustomerId])
  @@index([agencyId, section])
  @@index([agencyId, status])
  @@index([city, price])
  @@index([section, price])
  @@index([rooms])
  @@index([delistedAt])
  @@index([amenities], type: Gin)
  /// The join to `MarketDeal`. The index was created by the migration that added the
  /// columns but never declared here, so `migrate dev` would have proposed dropping it.
  @@index([gush, chelka])
}

/// One row per scrape, so a bad run can be told apart from a shrinking inventory.
model ScrapeRun {
  id       String  @id @default(cuid())
  agency   Agency  @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String
  section  Section

  cardsFound       Int
  listingsUpserted Int
  detailsMissing   Int
  failedTokens     String[]

  startedAt  DateTime  @default(now())
  finishedAt DateTime?

  @@index([agencyId, section, startedAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// Identity and access
// ──────────────────────────────────────────────────────────────────────────────

model User {
  id           String @id @default(cuid())
  /// Always stored lowercased. Postgres unique indexes are case-sensitive, so without
  /// normalising, Itay@x.com and itay@x.com are two accounts and the anti-enumeration
  /// responses quietly stop working. Normalise in auth/normalize-email.ts.
  email        String @unique
  passwordHash String

  firstName     String
  lastName      String
  phone         String?
  /// Profile picture. `avatarUrl` is a path this API serves; the object lives in the
  /// private bucket under `avatarStorageKey`. Null means fall back to initials.
  /// Whether they want the morning email of what is worth doing today.
  ///
  /// On by default, because a work tool that has to be switched on is a work tool
  /// nobody switches on — and off is one checkbox away on their own profile.
  dailyBriefing Boolean @default(true)

  /// When the last one went out, which is also what stops a second one the same day.
  /// Claimed before the mail is sent, so two instances cannot both send.
  lastBriefingAt DateTime?

  avatarUrl        String?
  avatarStorageKey String?
  /// A short self-description shown beside this agent's listings. Capped in the DTO at
  /// BIO_MAX_LENGTH; the column is unbounded so raising the cap needs no migration.
  bio              String?

  emailVerifiedAt DateTime?
  /// null = ordinary user. Set by seed or SQL only, never through an API.
  /// When this person agreed to the terms and the privacy policy.
  ///
  /// A timestamp rather than a boolean: what matters later is *when* they agreed, so a
  /// change to either document can be told apart from an account that predates it.
  termsAcceptedAt DateTime?

  platformRole PlatformRole?

  /// Bumping this invalidates every outstanding token: a cheap "log out everywhere".
  sessionEpoch     Int       @default(0)
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?
  disabledAt       DateTime?

  /// What this account is for. Explicit rather than inferred from "has a membership":
  /// the inference is true today but silently wrong the moment a buyer is invited to an
  /// agency, and it cannot be queried or indexed.
  accountType AccountType @default(buyer)

  /// Set when the account signed in through an identity provider. A row with a
  /// provider and no usable password came in through Google and must not be offered a
  /// password reset as though it had one.
  authProvider   AuthProvider?
  /// The provider's stable subject id. Never the email — Google addresses can change.
  authProviderId String?

  /// Present for a consumer: someone searching for a home rather than selling one.
  /// Identity stays in this table so there is one login, one session and one reset
  /// flow; only the consumer-specific data lives separately.
  buyerProfile BuyerProfile?

  memberships       AgencyMembership[]
  sessions          Session[]
  authTokens        AuthToken[]
  claims            AgencyClaim[]
  createdListings   Listing[]              @relation("ListingCreator")
  ownedListings     Listing[]              @relation("ListingOwner")
  ownedLeads        Lead[]                 @relation("LeadOwner")
  assignedLeads     Lead[]                 @relation("LeadAssignee")
  assignedCustomers Customer[]             @relation("CustomerAssignee")
  meetings          Meeting[]              @relation("MeetingOwner")
  suggestions       Suggestion[]           @relation("SuggestionOwner")
  coBrokeRequested  CoBrokerageRequest[]   @relation("CoBrokeRequester")
  coBrokeResponded  CoBrokerageRequest[]   @relation("CoBrokeResponder")
  coBrokeMessages   CoBrokerageMessage[]   @relation("CoBrokeMessageAuthor")
  savedSearches     SavedSearch[]
  meetingFeedback   Meeting[]              @relation("MeetingFeedbackAuthor")
  googleCalendar    GoogleCalendarAccount?
  ownedDeals        Deal[]                 @relation("DealOwner")
  reviewedAgencies  Agency[]               @relation("AgencyReviewer")
  reviewedClaims    AgencyClaim[]          @relation("ClaimReviewer")
  valuations        Valuation[]
  platformInvitesSent PlatformInvite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([authProvider, authProviderId])
  @@index([platformRole])
  @@index([accountType])
}

enum AuthProvider {
  google
}

enum AccountType {
  /// A consumer searching for a home. Has a BuyerProfile, no AgencyMembership.
  buyer
  /// Staff of an estate agency. Has a membership; may also have a BuyerProfile.
  agency
}

/// Everything a buyer has that an agency member does not. Keeping it out of `User`
/// means the consumer side can grow — alerts, search history, comparisons — without
/// widening the table every authentication path reads on each request.
model BuyerProfile {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  /// Free-text notes on what they are looking for; shown back to them, never public.
  searchNotes String?

  /// Notification preferences. Separate booleans rather than a JSON blob so they can
  /// be queried — "who wants a weekly digest" is a real question.
  notifyOnPriceDrop  Boolean @default(true)
  notifyOnNewMatches Boolean @default(true)
  weeklyDigest       Boolean @default(false)

  savedListings SavedListing[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// A listing a buyer kept. The join carries its own note, which is the point — "nice
/// kitchen, bad street" is what makes a shortlist useful.
model SavedListing {
  id String @id @default(cuid())

  /// Exactly one of these is set, enforced by a check constraint rather than by hope:
  /// a save belongs to an account, or to a browser that has not made one yet.
  profile   BuyerProfile? @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String?
  visitor   Visitor?      @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  visitorId String?

  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  note      String?
  createdAt DateTime @default(now())

  // Uniqueness is two partial indexes in the migration, not `@@unique` here: with a
  // nullable column Postgres counts NULLs as distinct, so a single compound unique
  // would let one visitor save the same listing any number of times.
  @@index([profileId, createdAt])
  @@index([visitorId, createdAt])
  @@index([listingId])
}

/// One person's interaction with one listing, so that a count can mean people.
///
/// A row per person per listing per kind, not per click: the seller's question is how
/// many people looked, and a page refreshed four times is one person.
model ListingEngagement {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  kind EngagementKind

  /// Whoever we can name: the account when there is one, otherwise the browser.
  userId    String?
  visitorId String?

  createdAt DateTime @default(now())

  @@index([listingId, kind])
}

enum EngagementKind {
  /// The listing was opened.
  view
  /// The contact number was asked for.
  phone
}

/// A browser that has saved something without signing up.
///
/// The id is random and opaque and means nothing on its own — it identifies a browser,
/// not a person, and carries no name, address or device characteristics. It exists so
/// that saving a listing works before anyone has decided to make an account, and it is
/// folded into that account the moment they do.
model Visitor {
  id String @id @default(cuid())

  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  /// Set when the browser's saves were merged into an account. The row is kept rather
  /// than deleted so the same cookie does not quietly start a second collection.
  mergedIntoProfileId String?

  savedListings SavedListing[]

  @@index([lastSeenAt])
}

/// A user's place in an agency. A join model rather than fields on User, because a
/// `pending` membership has nowhere to live on the user row, the claim needs an audit
/// trail, and agents move between agencies.
model AgencyMembership {
  id       String @id @default(cuid())
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  role   AgencyRole       @default(agent)
  status MembershipStatus @default(pending)

  /// Display link to the yad2-imported team row — avatar, licence number, counts.
  /// NEVER an authorization input: the scraper rewrites Broker rows on every run and
  /// matches some of them on name alone.
  broker   Broker? @relation(fields: [brokerId], references: [id], onDelete: SetNull)
  brokerId String? @unique

  invitedById String?
  joinedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, agencyId])
  @@index([agencyId, status])
}

/// A request to take over an agency that already exists from a scrape. Approving one
/// attaches the existing row to the claimant — nothing is ever merged or re-parented.
model AgencyClaim {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String

  status   ClaimStatus @default(pending)
  /// Whatever the signup form collected: licence number, office phone, a note.
  evidence Json?

  reviewedAt      DateTime?
  reviewedBy      User?     @relation("ClaimReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedById    String?
  rejectionReason String?

  createdAt DateTime @default(now())

  @@unique([agencyId, userId])
  @@index([status, createdAt])
}

model AgencyInvite {
  id          String     @id @default(cuid())
  agency      Agency     @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId    String
  email       String
  role        AgencyRole @default(agent)
  invitedById String
  /// sha256 of the token; the plaintext only ever exists in the email.
  tokenHash   String     @unique
  expiresAt   DateTime
  acceptedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([agencyId, acceptedAt])
}

/// An invitation from a platform admin. Accepting creates the account named by
/// `accountType`: a buyer uses the site, an agency may open the CRM.
/// The plaintext token only ever exists in the email; this stores its sha256.
model PlatformInvite {
  id        String    @id @default(cuid())
  email     String
  /// What the account will be when the link is accepted. A buyer uses the site;
  /// an agency may open the CRM.
  accountType AccountType @default(buyer)
  invitedBy User      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  invitedById String
  tokenHash String    @unique
  expiresAt DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?
  createdAt DateTime  @default(now())

  @@index([email, acceptedAt])
}

/// One row per refresh token. A login starts a family; each rotation adds a row and
/// tombstones its predecessor, so presenting a revoked token is provable reuse.
model Session {
  id        String @id @default(cuid())
  user      User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  /// Constant across every rotation of one login. Reuse kills the whole family.
  familyId  String
  /// sha256 of the token's secret half; the plaintext lives only in the cookie.
  tokenHash String

  expiresAt    DateTime
  revokedAt    DateTime?
  replacedById String?   @unique
  replacedBy   Session?  @relation("SessionChain", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces     Session?  @relation("SessionChain")

  ip         String?
  userAgent  String?
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

/// Email verification, password reset and invite acceptance in one table — one lookup
/// path and one expiry sweep. Hashes only, compared with timingSafeEqual.
model AuthToken {
  id         String           @id @default(cuid())
  user       User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  purpose    AuthTokenPurpose
  tokenHash  String           @unique
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int              @default(0)
  /// e.g. the proposed address for an email_change.
  meta       Json?
  createdAt  DateTime         @default(now())

  @@index([userId, purpose, consumedAt])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────────
// CRM
// ──────────────────────────────────────────────────────────────────────────────

/// Photos an agency uploaded here. Scraped listings keep using Listing.imageUrls,
/// which are yad2 CDN links and will be retired once agencies upload their own.
/// Every price a listing has carried.
///
/// So that "it came down" is a fact with a date on it rather than a number somebody
/// remembered. `Listing.priceBeforeDrop` is yad2's version of the same idea and is
/// neither ours nor complete: it exists only on scraped rows, holds one figure, and
/// disappears when their feed stops sending it.
///
/// Written by every path that can change a price — the scrape, the agency editor and
/// the seller's own form — so the history does not depend on which of the three a
/// listing happens to come through.
model ListingPriceChange {
  id        String  @id @default(cuid())
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  /// What it was before. Null on the first price ever recorded for this listing, which
  /// is a beginning rather than a change and is kept so the series has a start.
  previous Int?
  /// What it became.
  price    Int

  changedAt DateTime @default(now())

  /// The only query there is: this listing's prices, newest first.
  @@index([listingId, changedAt])
}

model ListingImage {
  id         String   @id @default(cuid())
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String
  /// Object key in the bucket; the public URL is derived from it.
  storageKey String   @unique
  url        String
  width      Int?
  height     Int?
  position   Int      @default(0)
  createdAt  DateTime @default(now())

  @@index([listingId, position])
}

/// Why an agency is talking to somebody. Not a status — a person can be looking to buy
/// one flat and to sell another at the same time, which is the `both` case.
enum CustomerKind {
  buyer
  seller
  both
}

/// A person the agency keeps, as opposed to an enquiry it received.
///
/// Distinct from `Lead` on purpose. A lead is an event — somebody asked about one
/// listing on one day, and it is answered or it goes cold. A customer is a relationship:
/// the same person over years, several properties, whatever the agent knows about them.
/// Collapsing the two would mean either losing which listing an enquiry was about, or
/// carrying a dead listing reference around a person who no longer cares about it.
model Customer {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  name  String
  phone String?
  email String?

  kind  CustomerKind @default(buyer)
  notes String?

  // ── what they are looking for ───────────────────────────────────────────────
  // The brief, in the same shape the public search takes it, so "show me what has
  // come in for this customer" is the ordinary search with these as its filters
  // rather than a second thing to keep in step.

  /// Buying, renting or commercial. Null while nobody has asked.
  lookingSection Section?
  /// Where. Several, because a brief is usually "Holon or Bat Yam".
  lookingCities  String[]
  /// Flat, penthouse, and so on. Empty means no preference stated.
  lookingTypes   String[]

  minRooms       Float?
  maxRooms       Float?
  minPrice       Int?
  maxPrice       Int?
  minSquareMeter Int?

  // ── the commission agreement ────────────────────────────────────────────────
  // הזמנת שירותי תיווך. Under the Real Estate Agents Law a broker can only claim a
  // fee where the client signed a written order, so for an agency this is not an
  // administrative detail: it is the difference between work that can be billed and
  // work that cannot. The agency needs to know, per person, before it does the work.

  /// When they signed. Null is the honest default — unknown and unsigned are the same
  /// thing here, because an agency that cannot produce the paper cannot charge either.
  agreementSignedAt DateTime?
  // What the agreement says the fee is — a percentage, or a sum, never worked out from
  // the other. Both are kept because agreements are written both ways and converting
  // between them needs a price nobody has agreed yet: 2% of what, before there is an
  // offer? Each is null until somebody fills it in, and null is not zero — zero is a
  // favour somebody did on purpose.

  /// Per cent of the price, before VAT, as every brokerage agreement states it.
  ///
  /// Per customer rather than one setting for the agency, because this is the figure
  /// that gets negotiated: the office may quote 2% and sign 1.5% with somebody buying
  /// their third flat.
  agreementCommissionPercent Float?
  /// A fixed fee in shekels, before VAT, for an agreement written that way instead.
  agreementCommissionAmount  Int?
  /// Where the signed copy is, its reference, which property it covers — whatever the
  /// agency needs to find it again. Free text on purpose: every office files
  /// differently and a structured field would be wrong for most of them.
  agreementNote              String?

  /// The agent who looks after them. Optional: a walk-in belongs to the agency before
  /// anybody has picked them up.
  assignedTo   User?   @relation("CustomerAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  meetings      Meeting[]
  /// The properties this person is selling, for a customer on the other side of the
  /// deal. Empty for most of them: a buyer owns nothing the agency is handling.
  ownedListings Listing[]            @relation("ListingSeller")
  suggestions   Suggestion[]
  coBrokerage   CoBrokerageRequest[]
  deals         Deal[]

  /// The list is "this agency's, newest first", which is the only query there is.
  @@index([agencyId, createdAt])
  @@index([assignedToId])
}

model Lead {
  id       String  @id @default(cuid())
  /// Null when the enquiry is about a private seller's listing, which has no agency.
  /// Exactly one of `agencyId` and `ownerUserId` is set.
  agency   Agency? @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String?

  /// The private seller the enquiry is for. An enquiry nobody receives is worse than
  /// no enquiry form, so this exists for the same reason `Listing.ownerUserId` does.
  owner       User?   @relation("LeadOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  ownerUserId String?

  /// The listing the enquiry came in on, when there was one.
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId String?

  source LeadSource @default(web)
  status LeadStatus @default(new)

  name    String
  phone   String?
  email   String?
  message String?
  notes   String?

  assignedTo   User?   @relation("LeadAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  assignedToId String?

  deals       Deal[]
  suggestions Suggestion[]

  contactedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([agencyId, status, createdAt])
  @@index([listingId])
  @@index([assignedToId])
}

/// A user's connected Google Calendar.
///
/// Its own row rather than columns on `User`, so disconnecting is a delete — there is
/// no half-connected state where a stale refresh token sits beside a null calendar id.
///
/// The refresh token is stored as given, because unlike every other token in this
/// schema it has to be *used* rather than compared: hashing it would make it useless.
/// It is a credential for somebody's calendar and should be treated as one.
model GoogleCalendarAccount {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  /// The Google account that was connected, for showing which one it is.
  googleEmail String

  refreshToken String
  /// Which calendar to write to. `primary` unless somebody picks another.
  calendarId   String @default("primary")

  /// When the last push or pull failed, and why — so a connection that has quietly
  /// stopped working can say so instead of looking fine.
  lastError   String?
  lastSyncAt  DateTime?
  connectedAt DateTime  @default(now())
}

/// A meeting is either still coming, or it happened, or it did not.
enum MeetingStatus {
  scheduled
  done
  cancelled
}

/// How a viewing went, in the words an agent would use about it afterwards.
///
/// One field rather than an attendance flag plus an interest score: "did not turn up"
/// and "came and hated it" are different outcomes, not the same outcome with a missing
/// rating, and asking an agent two questions where one will do is how summaries stop
/// being written.
enum ViewingOutcome {
  /// Wants to go further — a second viewing, an offer, the paperwork.
  interested
  /// Came, has not decided.
  thinking
  /// Came, not for them.
  not_interested
  /// Did not turn up.
  no_show
}

/// What the person on the other side said about it.
enum AttendeeResponse {
  /// Nothing sent, or sent and not answered.
  pending
  confirmed
  declined
}

/// Something in an agent's diary: a viewing, a valuation, a signing.
///
/// Ours, not Google's. An agency that never connects a Google account still has a
/// working calendar, and one that connects it gets its meetings pushed there — the
/// relationship is "we own the record, Google is a copy", because the other way round
/// means losing the diary when somebody revokes an OAuth grant.
model Meeting {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  /// Who it is with. Optional: a team meeting is still a meeting.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?
  /// The property it is about, for a viewing.
  listing    Listing?  @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId  String?

  title    String
  startsAt DateTime
  endsAt   DateTime
  location String?
  notes    String?

  status MeetingStatus @default(scheduled)

  // ── confirmation and reminders ──────────────────────────────────────────────

  /// What the customer said. `pending` covers both "not asked" and "asked, no answer":
  /// `confirmationSentAt` is what tells those apart.
  attendeeResponse    AttendeeResponse @default(pending)
  attendeeRespondedAt DateTime?

  /// Unguessable, and the only thing standing between a stranger and somebody else's
  /// appointment — so it is issued per meeting and only when a confirmation is sent.
  /// The page behind it shows a time, a place and a first name, and nothing else.
  confirmationToken  String?   @unique
  confirmationSentAt DateTime?

  /// When the reminder went out, which is also what stops it going out twice. Null and
  /// in the past means due.
  reminderSentAt DateTime?

  // ── the other side of the viewing ───────────────────────────────────────────
  // A viewing is an arrangement between three people, and the agent is only one of
  // them. The buyer's half is above; this is the half belonging to whoever has to open
  // the door. Kept apart from `attendeeResponse` rather than folded into one "confirmed"
  // flag, because "the buyer is coming but the seller has not answered" is the state an
  // agent most needs to see, and a single flag cannot say it.

  /// What the property's owner said about this time.
  sellerResponse    AttendeeResponse @default(pending)
  sellerRespondedAt DateTime?

  /// What they said in their own words — nearly always when the answer is no, and
  /// nearly always the useful part: "not before five" saves a round of telephone tag.
  sellerNote String?

  /// Their own link, separate from the buyer's. One token for both would let either of
  /// them answer as the other.
  sellerToken   String?   @unique
  sellerAskedAt DateTime?

  // ── after the viewing ───────────────────────────────────────────────────────

  /// How it went. Null on a meeting that has not happened yet — and on one that has,
  /// which is exactly what the calendar chases the agent about.
  outcome       ViewingOutcome?
  feedbackNotes String?
  feedbackAt    DateTime?

  /// Who wrote the summary, which is not always whose meeting it was: a colleague
  /// covering a viewing is the one who knows how it went.
  feedbackBy   User?   @relation("MeetingFeedbackAuthor", fields: [feedbackById], references: [id], onDelete: SetNull)
  feedbackById String?

  /// When to go back to this person.
  ///
  /// A date rather than another meeting: "ring them on Thursday" is not an appointment
  /// and putting it in the diary as one makes a calendar nobody trusts. Set when the
  /// viewing is written up, cleared when somebody says they have done it.
  followUpAt     DateTime?
  followUpDoneAt DateTime?

  /// Whose diary it is. Null means the agency's rather than one agent's.
  owner   User?   @relation("MeetingOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  /// The copy in Google, when the owner has connected an account. Null means it was
  /// never pushed — because nobody is connected, or because the push failed, which is
  /// not a reason to refuse the meeting.
  googleEventId String?

  suggestions Suggestion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The calendar asks for one range at a time, which is the only query there is.
  @@index([agencyId, startsAt])
  @@index([customerId])
  @@index([ownerId])
}

model Deal {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  lead      Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  leadId    String?
  listing   Listing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId String?

  /// Who the deal is with.
  ///
  /// A lead is an event — somebody enquired once — and a customer is the relationship
  /// that follows it. A deal belongs to the second: the person whose brief the agency
  /// holds, whose viewings it booked and who it will ring when this one falls through.
  /// Without this the pipeline and the CRM were two products sharing a database.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?

  stage DealStage @default(qualified)
  title String

  /// Agreed price in whole shekels, and the agency's commission.
  /// `commissionPercent` is the percentage agreed (e.g. 2 for 2%), while
  /// `commission` holds the total shekel amount if fixed or already calculated.
  price             Int?
  commission        Int?
  commissionPercent Float?

  expectedCloseAt DateTime?
  closedAt        DateTime?
  lostReason      String?
  notes           String?

  owner   User?   @relation("DealOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId, stage, createdAt])
  @@index([leadId])
  /// "What is open for this person", which the customer's own page asks.
  @@index([customerId])
}

/// A place an agency works out of, drawn on the public map under the agency's name.
///
/// Separate from `Agency.phone` and the rest of the profile because an agency has more
/// than one: a head office and branches, each in a different town, each worth finding.
model AgencyOffice {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  /// "סניף רמת גן". Optional — one office needs no name beyond the agency's own.
  label String?

  city        String
  street      String?
  houseNumber Int?

  /// Worked out from the address when it was saved, not at render time: a map showing
  /// twenty offices would otherwise be twenty geocoding requests per view.
  ///
  /// Null when the address could not be placed. Such an office still exists and still
  /// shows in the agency's own list — it is simply not drawn.
  latitude  Float?
  longitude Float?

  /// A branch number, where it differs from the agency's main line.
  phone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([agencyId])
}

/// Outlines the map draws: municipalities, and the regions people actually search by.
///
/// Pulled from OpenStreetMap once by `npm run boundaries:sync` rather than fetched per
/// request: Nominatim's policy forbids systematic use, Overpass rate-limits anonymous
/// callers, and a municipal boundary changes about never. Storing them makes the map
/// independent of either service being up.
/// Every street in Israel, from the Interior Ministry's list via data.gov.il.
///
/// A table rather than a file shipped to the browser: 63,000 streets is a megabyte
/// nobody should download to fill in one address field. The city list is 1,300 names
/// and goes in the bundle; this one is answered per city, as it is typed.
model Street {
  id String @id @default(cuid())

  /// The locality as the source spells it, kept for display and for tracing a row back.
  city    String
  /// What the lookup matches on — `cityKey(city)`, because the city on a form comes
  /// from the locality file and the two spellings of a hyphenated name must meet.
  cityKey String
  name    String

  /// The Interior Ministry's own code for the street within its locality. Not used for
  /// anything yet; kept because re-deriving it later would mean another import.
  code Int?

  /// A point on the street, filled in the first time anyone asks for this one.
  ///
  /// The register has names and no coordinates, so these come from the geocoder and
  /// are kept forever once found — see `PlaceService.locateStreet` for why that
  /// caching is the whole reason this is allowed to exist.
  latitude  Float?
  longitude Float?

  /// When the geocoder was last asked, whether or not it answered. Without it a
  /// street the geocoder cannot place is looked up again on every single request.
  locatedAt DateTime?

  syncedAt DateTime @default(now())

  /// One row per street per city. The sync upserts on it, so a re-run updates rather
  /// than duplicates.
  @@unique([cityKey, name])
  /// What the suggestions query filters and orders by.
  @@index([cityKey, name])
}

model CityBoundary {
  id String @id @default(cuid())

  /// The name exactly as OpenStreetMap has it, for display and for tracing a row back.
  name   String
  nameEn String?

  /// What the lookup actually matches on: `name` with separators and Hebrew
  /// punctuation flattened, because OSM writes `תל־אביב–יפו` and a listing says
  /// `תל אביב יפו`. See `cityKey` in src/listings/city-name.ts — both sides use it.
  ///
  /// Unique within a kind rather than overall: a region and a city can legitimately
  /// share a name, and `חיפה` is both a city and part of a region's name.
  matchKey String

  /// A single municipality, or a region made of several.
  kind BoundaryKind @default(city)

  /// For a region: every city it covers, so a search for it is an ordinary `city IN`
  /// and needs no geometry at query time. Worked out during the sync by testing each
  /// city's centre against the region's outline. Empty for a city, which is itself.
  memberCities String[]

  /// The OSM relation this came from, so a re-sync can tell an update from a new row
  /// and a human can go and look at the source. Null for a region, which is assembled
  /// from several relations rather than being one.
  osmRelationId BigInt? @unique
  /// 8 is a municipality. 10 would be a neighbourhood, where Israeli coverage is thin.
  /// A region carries the level of the units it was built from.
  adminLevel    Int     @default(8)

  /// A GeoJSON Polygon or MultiPolygon. Kept whole rather than normalised into points:
  /// nothing queries inside it, the map just draws it.
  geometry Json

  /// The bounding box, extracted on write so the map can frame the area without
  /// parsing the geometry first.
  minLat Float
  maxLat Float
  minLng Float
  maxLng Float

  syncedAt  DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([kind, matchKey])
  @@index([adminLevel])
  @@index([kind])
}

/// A municipality, or a marketing region assembled from several sub-districts.
enum BoundaryKind {
  city
  district
}

/// What the system has decided is worth an agent's attention.
///
/// The thing that makes this a suggestion rather than a dashboard tile is the status:
/// somebody can be done with one, or say no to it, and the nightly sweep has to respect
/// that forever. `dedupeKey` is what makes that possible — it is the identity of the
/// *observation*, not of the row, so a sweep that notices the same thing tomorrow finds
/// the dismissed row and leaves it alone.
model Suggestion {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  /// Whose to act on — the agent who looks after the customer. Null means the agency's,
  /// which is what an unassigned customer produces.
  owner   User?   @relation("SuggestionOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  ownerId String?

  kind   SuggestionKind
  status SuggestionStatus @default(open)

  /// What it is about. Which of these are set depends on the kind.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId String?
  listing    Listing?  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId  String?
  lead       Lead?     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId     String?
  meeting    Meeting?  @relation(fields: [meetingId], references: [id], onDelete: Cascade)
  meetingId  String?

  /// 0–100: how strong the evidence is, not how urgent the task. A vague brief that
  /// matches is weaker evidence than a precise one, and the score says so.
  score Int

  /// Why this appeared, in the words an agent reads. Written by the rule that raised
  /// it, from the facts it compared — never generated, so it cannot be wrong.
  reason String

  /// Until when somebody does not want to see it. Separate from `status` so "later"
  /// does not need its own state machine.
  snoozedUntil DateTime?
  /// When somebody acted on it or waved it away.
  actedAt      DateTime?

  /// The identity of the observation: agency, kind and whatever it is about. Unique,
  /// so the sweep is an upsert and running it twice in an hour changes nothing.
  dedupeKey String @unique

  /// A message to the customer, written by the model and not sent by it.
  ///
  /// Stored rather than generated on every view, for three reasons: it costs money, an
  /// agent who liked the wording should find the same wording tomorrow, and a draft
  /// they edited is theirs and must not be silently rewritten. Regenerating is a
  /// button, which is the point — nothing here reaches a customer without a person.
  draft   String?
  draftAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The one query the radar makes: this agency's open ones, best first.
  @@index([agencyId, status, score])
  @@index([ownerId, status])
  @@index([customerId])
  @@index([listingId])
  @@index([leadId])
  @@index([meetingId])
}

enum SuggestionKind {
  /// A listing this agency holds matches what a customer said they want.
  new_match
  /// Another agency's listing matches one of ours. The co-brokerage case.
  cobroke_match
  /// A viewing is close and one of the two sides has not said yes.
  viewing_unanswered
  /// An enquiry came in and nothing has happened to it since.
  stale_lead
  /// A listing has been on the market a while and nobody has asked about it.
  listing_no_interest
}

enum SuggestionStatus {
  open
  /// Acted on — the agent did the thing.
  done
  /// Not interested, and not to be raised again.
  dismissed
}

/// One row this agency's demo data created, so clearing it can be exact.
///
/// The alternative — delete everything belonging to the agency, or everything whose
/// name looks made up — is how somebody loses real work to a button marked "clear test
/// data". Nothing is guessed: the seed writes a row here for every record it creates,
/// and the clear deletes those ids and nothing else.
model DemoRecord {
  id       String @id @default(cuid())
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  /// The Prisma model name, e.g. `Customer`. A string rather than an enum: this table
  /// exists to be read by one switch statement, and a migration every time the seed
  /// learns to create another kind of thing would be friction for no safety.
  model    String
  recordId String

  createdAt DateTime @default(now())

  @@unique([model, recordId])
  /// The clear reads "everything this agency seeded", which is the only query there is.
  @@index([agencyId, model])
}

/// One agency asking another to work a deal together.
///
/// The only row in the system that belongs to two agencies, which is why its policies
/// name both. Everything else here follows from one asymmetry: the listing is already
/// public on the marketplace, and the buyer is not. So the holding agency learns that
/// somebody has a buyer for their property and what that buyer is looking for — never
/// who they are, and never what they can afford, since the listing's own price already
/// proves they can afford it and the headroom above it is the buyer's to keep.
model CoBrokerageRequest {
  id String @id @default(cuid())

  /// The property. Public already, so both sides see all of it.
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String

  /// Whose property it is — the agency being asked.
  holdingAgency   Agency @relation("CoBrokeHolding", fields: [holdingAgencyId], references: [id], onDelete: Cascade)
  holdingAgencyId String

  /// Who has the buyer — the agency asking.
  seekingAgency   Agency @relation("CoBrokeSeeking", fields: [seekingAgencyId], references: [id], onDelete: Cascade)
  seekingAgencyId String

  /// The buyer. **Never sent to the holding agency.**
  ///
  /// Row-level security cannot hide a column, so this is kept out by the service: the
  /// two sides have their own selects and only one of them mentions this. A test holds
  /// that line, because a comment cannot.
  customer   Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerId String?

  /// The agent who asked, and the one who answered.
  requestedBy   User?   @relation("CoBrokeRequester", fields: [requestedById], references: [id], onDelete: SetNull)
  requestedById String?
  respondedBy   User?   @relation("CoBrokeResponder", fields: [respondedById], references: [id], onDelete: SetNull)
  respondedById String?

  status CoBrokerageStatus @default(pending)

  /// What the seeking agent wrote. Shown to the other side, so it is theirs to get
  /// right — and the one place a human can say what a match cannot.
  message String?

  /// The share of the commission going to the agency that brought the buyer, as a
  /// percentage. A record of what was said, not an agreement: the two agencies have
  /// their own paperwork and this does not replace it.
  commissionSplit Int @default(50)

  /// What the buyer is after, as it stood when the request was made.
  ///
  /// Copied rather than read through `customer`, because the holding agency may read
  /// this row and may not read that customer — and because a brief that changes next
  /// week should not silently rewrite what somebody was asked.
  briefSummary String?

  /// How far the deal has got, once there is a deal.
  ///
  /// A second axis from `status`, not a continuation of it: `status` is whether the two
  /// agencies agreed to work together, and this is what has happened since. Null until
  /// somebody accepts, because before that there is nothing to be at a stage of.
  stage CoBrokerageStage?

  /// When each side last looked at the conversation, which is all an unread badge needs.
  /// Per side rather than per message: the question is "is there something new for me",
  /// and a row per person per message would be a lot of bookkeeping for one dot.
  seekerReadAt DateTime?
  holderReadAt DateTime?

  messages CoBrokerageMessage[]

  respondedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  /// Both inboxes, and the guard against asking twice about the same pair.
  @@unique([listingId, seekingAgencyId, customerId])
  @@index([holdingAgencyId, status])
  @@index([seekingAgencyId, status])
}

/// What the two agencies say to each other once they are working together.
///
/// Deliberately not a chat: a handful of messages about one deal, kept beside the deal
/// so that "what did we agree about the commission" has an answer six weeks later. The
/// alternative is a WhatsApp thread neither agency can produce when it matters.
model CoBrokerageMessage {
  id        String             @id @default(cuid())
  request   CoBrokerageRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  requestId String

  /// Which side wrote it. Both agencies may read the thread, so this is what tells
  /// "us" from "them" on screen.
  agency   Agency @relation(fields: [agencyId], references: [id], onDelete: Cascade)
  agencyId String

  author   User?   @relation("CoBrokeMessageAuthor", fields: [authorId], references: [id], onDelete: SetNull)
  authorId String?

  body String

  createdAt DateTime @default(now())

  /// The thread, oldest first, which is the only query there is.
  @@index([requestId, createdAt])
}

enum CoBrokerageStage {
  /// Agreed to work together, nothing has happened yet.
  agreed
  /// A viewing is arranged or has happened.
  viewing
  /// An offer is on the table.
  negotiating
  /// Contracts signed.
  signed
  /// Done, and the commission settled.
  completed
  /// It came to nothing. Kept rather than deleted — a deal that fell through is a
  /// thing that happened, and the two agencies may well try again.
  fell_through
}

enum CoBrokerageStatus {
  pending
  accepted
  declined
  /// The asking agency changed its mind before an answer came.
  withdrawn
}

/// A search somebody wants to be told about.
///
/// The criteria are the public search's own filters rather than a new vocabulary, so
/// "alert me about this" is the search they just ran and the email can link back to
/// exactly it. The agency side already works this way — `Customer`'s brief is stored in
/// the same shape — and the matching code is shared between them.
model SavedSearch {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  /// What they called it. "4 חדרים בחולון" is a better subject line than a filter list.
  name String

  // ── the criteria ────────────────────────────────────────────────────────────
  section        Section?
  cities         String[]
  propertyTypes  String[]
  minRooms       Float?
  maxRooms       Float?
  minPrice       Int?
  maxPrice       Int?
  minSquareMeter Int?

  /// Whether to email at all. Off leaves the search saved and silent, which is a thing
  /// people want: the list is useful without the post.
  alert Boolean @default(true)

  /// When we last wrote to them, which is also what stops two emails in one day.
  lastAlertAt DateTime?

  /// The newest listing we have already told them about.
  ///
  /// "New" is measured against this rather than against `lastAlertAt`, so a sweep that
  /// was late or an email that failed skips nothing — and so a search saved today does
  /// not open with the entire back catalogue, because this starts at the moment it was
  /// created.
  notifiedUpTo DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// Theirs, newest first — the only query the account page makes.
  @@index([userId, createdAt])
  /// And the sweep's: everyone who wants an email.
  @@index([alert, lastAlertAt])
}

/// Where a transaction came from, so two sources can run side by side and be compared.
enum MarketDealSource {
  /// The community mirror of the Tax Authority registry.
  mashkof
  /// The registry itself, once we have our own access to it.
  taxAuthority
}

/// One real-estate transaction reported to the Israel Tax Authority.
///
/// Our own copy, synced on a schedule — never fetched while a page is rendering. The
/// upstream is somebody else's server, and a property page that waits on it is exactly
/// as fast and as available as they are. Holding the data also means comps are a join
/// on our own indexes rather than a filter applied to whatever an HTTP API returns.
///
/// **The registry has no street addresses.** A deal is located by settlement plus
/// gush/chelka — the cadastral block and parcel — which is why `Listing` carries those
/// two columns as well. They are the only key that joins our listings to this table.
///
/// History is kept in full, back to 1998. Comps are computed over a recent window and
/// would be poisoned by a deal from 2003, but a property page showing what this flat
/// sold for in 2014 and again in 2021 needs 2014 — and the back catalogue is the part
/// that can never be re-fetched if the upstream goes away.
/// Named `MarketDeal`, not `Deal`: the CRM already has a `Deal`, and that one is an
/// opportunity in an agency's own pipeline. This is a sale that happened, recorded by
/// the state. Two very different things that both get called "עסקה" in Hebrew.
model MarketDeal {
  /// The upstream's own id, so a re-run upserts rather than duplicates.
  id     String           @id
  source MarketDealSource

  /// When we last wrote this row, and the source's own data cut-off at that moment.
  /// Together they answer "how fresh is this really", which a user is entitled to ask.
  syncedAt DateTime  @default(now())
  dataAsOf DateTime?

  settlementCode Int
  settlement     String
  gush           Int
  chelka         Int
  subChelka      Int?

  dealDate   DateTime
  /// Price of the share sold. See `isFullDeal` before comparing it with anything.
  dealAmount BigInt

  rooms       Float?
  area        Int?
  pricePerSqm Int?
  yearBuilt   Int?

  /// The upstream's grouping — residential, land, commercial — and the raw Hebrew
  /// description of the transaction, kept as given rather than mapped to our own enum.
  propertyGroup String?
  dealNature    String?

  /// False when only part of a property changed hands, which makes `dealAmount`
  /// incomparable with a full price. The upstream's own statistics exclude these.
  isFullDeal Boolean @default(true)
  /// The upstream's verdict on whether this row belongs in a median at all: it marks
  /// outliers, multi-unit rows and partial deals. Trusted rather than recomputed —
  /// they have the whole set and we have a copy.
  inStats    Boolean @default(true)

  latitude  Float?
  longitude Float?

  /// When the upstream first saw this row. The cursor the daily sync advances on, and
  /// deliberately not `dealDate`: deals surface in the registry about three months
  /// after they happen, so syncing on the deal date would miss every late report.
  firstSeen DateTime?

  /// The grid cell this deal's point falls in — the same hand-rolled spatial index
  /// `Parcel` uses, for the same reason: there is no PostGIS here, and valuation asks
  /// "every deal within 400 m of this flat" over three million rows. A bounding-box
  /// filter on latitude alone matches half the table however it is indexed; an
  /// equality range on a cell pair does not. See `cadastre/parcel-index.ts`, whose
  /// `cellOf` fills these.
  cellLat Int?
  cellLng Int?

  /// The join to our own listings, and the only index a property page uses.
  @@index([gush, chelka])
  /// Everything a city or neighbourhood page asks: deals here, newest first.
  @@index([settlementCode, dealDate])
  /// The sync's own cursor.
  @@index([source, firstSeen])
  /// Comp selection: the nine cells around a point, newest first.
  @@index([cellLat, cellLng, dealDate])
}

/// A cadastral parcel — one (gush, chelka) and the ground it covers.
///
/// Imported once from the Survey of Israel's parcels layer, published as open data on
/// data.gov.il. Held locally because the lookup it serves — which parcel is this
/// listing on — is the only join between our listings and the transaction registry,
/// and because the obvious alternative, GovMap's parcel endpoint, serves browsers
/// only (see `CadastreService`).
///
/// `cellLat`/`cellLng` are a hand-rolled spatial index: this Postgres has no PostGIS,
/// and a btree over the bounding box is useless because `minLat <= :lat` matches half
/// the table. Parcels are filed by the cell their centroid falls in and a lookup reads
/// the nine cells around the point — see `parcel-index.ts` for why nine is enough.
model Parcel {
  gush   Int
  chelka Int

  /// Bounding box in WGS84, for the cheap rejection before ray casting.
  minLat Float
  maxLat Float
  minLng Float
  maxLng Float

  cellLat Int
  cellLng Int

  /// GeoJSON, in the same shape `CityBoundary.geometry` uses so the existing
  /// point-in-polygon code reads it without a second format to maintain.
  geometry Json

  importedAt DateTime @default(now())

  @@id([gush, chelka])
  @@index([cellLat, cellLng])
}

/// One estimate we gave someone, kept exactly as it was given.
///
/// Sellers screenshot numbers and come back to them months later, and an agent will
/// be asked to defend one in front of a buyer. So this records not only the answer
/// but everything it was computed from: the inputs, the parameter version, and the
/// comparable sales themselves. Refitting the parameters must never silently change
/// what an old valuation said.
model Valuation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// Who asked, when we know. Anonymous valuations are expected and allowed.
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  /// The data sheet as it was submitted, so the estimate can be recomputed from it.
  input Json

  /// Where the subject is, denormalised out of `input` for the queries we actually run.
  settlementCode Int?
  city           String
  gush           Int?
  chelka         Int?
  latitude       Float?
  longitude      Float?
  rooms          Float
  area           Int

  /// The answer. Null when we refused — `verdict` says why, and a refusal is worth
  /// storing: a town we cannot price is a product problem, not an absence of data.
  low      Int?
  high     Int?
  expected Int?
  asking   Int?

  /// 'good' | 'indicative' | 'too-thin' | a refusal reason.
  verdict String

  /// How the estimate was reached, for the explanation and for the back-test:
  /// pooled rate, the size exponent used, the quality multiplier and its parts,
  /// the market verdict, and every comparable with its weight and distance.
  workings Json

  /// Which `valuation-params.json` produced this. Without it the number is not
  /// reproducible, which would make the two fields above a liability.
  paramsVersion Int
  /// The index base — how current the market data behind this estimate was.
  paramsBase    String

  /// Effective comparable count and their dispersion, kept out of `workings` because
  /// every quality report groups by them.
  effectiveComps Float
  spread         Float

  @@index([createdAt])
  @@index([userId, createdAt])
  /// Quality reporting: how we do per town, and where we refuse.
  @@index([settlementCode, verdict])
}
