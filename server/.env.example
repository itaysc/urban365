# Copy to `.env` and fill in values. Never commit `.env`.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5555

# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres from docker-compose.yml at the repo root: docker compose up -d
# On Railway, reference the Postgres service instead: ${{Postgres.DATABASE_URL}}
DATABASE_URL=postgresql://nadlan:nadlan@localhost:5432/nadlan?schema=public
# The non-owner role that row-level security applies to. Every tenant-facing query uses
# it. Unset falls back to DATABASE_URL, which means RLS does NOT apply — fine before the
# policy migration, not after.
APP_DATABASE_URL=

# ─── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 48
# The server refuses to start in production without a strong one.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789
# Set to a shared parent domain (".nadlan.co.il") to share cookies across subdomains.
COOKIE_DOMAIN=

# ─── Mail ────────────────────────────────────────────────────────────────────
# Empty RESEND_API_KEY = console transport: links are logged, nothing is sent.
RESEND_API_KEY=
MAIL_FROM=Nadlan <onboarding@resend.dev>
# Where users land after an email link is validated.
APP_URL=http://localhost:5173
# Where the API is reachable. Email links hit this first so the token never reaches the
# browser. Defaults to APP_URL, which is right in dev because Vite proxies /api.
API_URL=

# ─── Captcha ─────────────────────────────────────────────────────────────────
# Cloudflare Turnstile. Only enforced in production.
TURNSTILE_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API.
# In production set this to the deployed client origin.
CORS_ORIGINS=http://localhost:5173

# ─── yad2 scraping ───────────────────────────────────────────────────────────
# yad2 is behind Radware Bot Manager: it serves a challenge page to a freshly
# launched automation browser, so a live scrape needs a Chrome that has already
# passed the check. Start one with:
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#     --remote-debugging-port=9222 --user-data-dir="$HOME/chrome-yad2"
# browse to yad2 once in that window, then set:
# YAD2_CDP_URL=http://127.0.0.1:9222
YAD2_CDP_URL=

# Pause between requests while scraping (ms).
YAD2_DELAY_MS=150

# Where scraped agencies are cached.
# YAD2_CACHE_DIR=./data/agencies

# ─── Image storage (Backblaze B2, S3-compatible API) ─────────────────────────
# Leave empty and uploads return a clean 503 — everything else keeps working.
# The bucket is PUBLIC-READ, unlike the reference project's private one: listing photos
# need stable, cacheable URLs, and a presigned GET caps at 7 days.
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=https://s3.us-west-004.backblazeb2.com
B2_REGION=us-west-004
# Where objects are served from, e.g. https://f004.backblazeb2.com/file/<bucket>
B2_PUBLIC_BASE_URL=
