# Copy to `.env` and fill in values. Never commit `.env`.
#
# Nothing here is required to boot in development: every integration degrades to a
# working local default (mail prints to the console, uploads return 503, captcha is
# skipped). The two you will actually want are DATABASE_URL and, once you have a
# bucket, the B2_* block.
#
# For production, the must-set list is: DATABASE_URL, APP_DATABASE_URL, JWT_SECRET,
# CORS_ORIGINS, APP_URL. The server refuses to start without a strong JWT_SECRET or
# with "*" in CORS_ORIGINS.

# ─── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5555

# ─── Database ────────────────────────────────────────────────────────────────
# Local Postgres comes from Homebrew; `npm run dev` starts it and creates both roles.
#   brew install postgresql@17
# On Railway, reference the Postgres service instead: ${{Postgres.DATABASE_URL}}
#
# This role OWNS the tables, so it bypasses row-level security. Migrations, auth, the
# admin moderation queue and the scraper run on it — the queries that must cross
# agencies or touch the identity tables.
DATABASE_URL=postgresql://nadlan:nadlan@localhost:5432/nadlan?schema=public

# The non-owner role (NOBYPASSRLS) that row-level security actually applies to. Every
# tenant-facing query uses it, so a forgotten `where agencyId` still cannot leak.
# Unset falls back to DATABASE_URL, which means RLS does NOT apply — fine before the
# policy migration, not after.
APP_DATABASE_URL=postgresql://nadlan_app:nadlan_app@localhost:5432/nadlan?schema=public

# ─── Auth ────────────────────────────────────────────────────────────────────
# 32+ random characters. Generate with: openssl rand -base64 48
# The server refuses to start in production without a strong one.
JWT_SECRET=dev-only-insecure-secret-change-me-0123456789

# Set to a shared parent domain (".nadlan.co.il") to share cookies across subdomains.
# Leave empty for localhost.
COOKIE_DOMAIN=

# ─── Mail (Resend) ───────────────────────────────────────────────────────────
# Empty RESEND_API_KEY = console transport: verification, reset and invite links are
# printed to the server log and nothing is sent. That is enough to exercise every
# flow locally, so you do not need a Resend account to develop.
RESEND_API_KEY=
MAIL_FROM=Nadlan <onboarding@resend.dev>

# Where users land after an email link is validated.
APP_URL=http://localhost:5173

# Where the API is reachable. Email links hit this first so the token never reaches the
# browser history or a Referer header. Defaults to APP_URL, which is right in dev
# because Vite proxies /api.
API_URL=http://localhost:5555

# ─── Google sign-in ──────────────────────────────────────────────────────────
# From Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID,
# type "Web application". Leave empty and the Google button is simply not offered —
# `GET /auth/google/available` reports false and the client hides it.
#
# Register this exact redirect URI on the client (it is derived from API_URL):
#   http://localhost:5555/api/v1/auth/google/callback      (local)
#   https://<your-api-host>/api/v1/auth/google/callback    (deployed)
#
# Authorised JavaScript origins are not needed — this is a server-side redirect flow,
# so no token ever touches the browser.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── Captcha ─────────────────────────────────────────────────────────────────
# Cloudflare Turnstile, on signup and forgot-password. Only enforced in production, so
# an empty value is correct in development.
TURNSTILE_SECRET=

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API. In production set this to the
# deployed client origin; "*" is refused, because it cannot be used with credentialed
# cookies and would disable the CSRF origin check.
CORS_ORIGINS=http://localhost:5173

# ─── yad2 import ─────────────────────────────────────────────────────────────
# yad2 sits behind Radware Bot Manager: it serves a challenge page to a freshly
# launched automation browser, so a live import needs a Chrome that has already passed
# the check. Start one with:
#   "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" \
#     --remote-debugging-port=9222 --user-data-dir="$HOME/chrome-yad2"
# browse to yad2 once in that window, then set this. Without it the import will fail
# with BOT_CHECK; nothing else is affected.
YAD2_CDP_URL=

# Pause between requests while importing (ms). Be polite.
YAD2_DELAY_MS=150

# Where imported agency payloads are cached on disk, so a mapping change can be
# replayed without re-scraping. Defaults to ./data/agencies.
# YAD2_CACHE_DIR=./data/agencies

# Set to false to hide yad2 from agencies: the import, and every mention of it.
# A platform admin still sees both. Unset means agencies see it.
# YAD2_FOR_AGENCIES=false

# ─── Image storage (Backblaze B2, S3-compatible API) ─────────────────────────
# Leave empty and every upload returns a clean 503 — listings, leads, deals and the
# yad2 import all keep working without it.
#
# The bucket is PRIVATE. Nothing is ever served straight from Backblaze: uploads come
# through this API and the bytes are read back by our own routes
# (GET /api/v1/listings/images/:id, GET /api/v1/agencies/:id/cover). That is the same
# shape the reference project uses for avatars, and it is why there is no public base
# URL to configure — these five values are the whole of it.
#
# From Backblaze: create a **private** bucket, then an application key scoped to it.
# ENDPOINT and REGION are shown on the bucket page and must match each other (the 004
# below is an example — yours may differ).
B2_APPLICATION_KEY=""
B2_BUCKET="nadlan"
B2_ENDPOINT="https://s3.us-east-005.backblazeb2.com"
B2_KEY_ID="005268a30e2066d0000000002"
B2_REGION="us-east-005"

# ─── OpenAI ──────────────────────────────────────────────────────────────────
# Used to read a private seller's listing and decide whether it looks like a real
# property. Empty switches the check off: listings publish without being read, which
# is the right failure — refusing a real seller costs more than letting one spam
# listing through for a person to find.
OPENAI_API_KEY=
# Somewhere else that speaks the same API — a gateway, or a stub in a test.
# OPENAI_BASE_URL=

# Background sweeps: viewing reminders (every 5 min), matching and saved-search alerts.
# On unless this is exactly "false". Turn them off before launch, when nothing is due
# and the five-minute tick is the only thing keeping the database from scaling to zero.
SCHEDULERS_ENABLED=true
MAIL_FROM=Urban365 <support@urban365.co.il>

# Close the public site while it is in הרצה. Guests get the home page blurred under a
# login, and new accounts can only be opened from an admin invite in the CRM.
# Anything but "true" leaves the site open.
SITE_CLOSED=false

# Hold a regular user's listing until an admin approves it in ניהול פלטפורמה.
# Agencies are not affected. Anything but "true" publishes immediately, as today.
LISTING_REVIEW=false
